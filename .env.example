# Copy to .env.local for `next dev`. In Cloudflare Pages, set these as
# Environment Variables/Secrets instead — see the "CODEship Academy learning
# platform" section of README.md.

# Client-exposed (Next.js requires the NEXT_PUBLIC_ prefix for anything read
# in the browser — the brief's own SUPABASE_URL/SUPABASE_ANON_KEY names are
# reserved below for server-only use, matching PR #14's Stripe integration).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Server-only — service role key, used by src/app/api/academy/*/route.ts to
# seed content, verify student/teacher sessions, and enforce capstone gating.
# Same variable names as PR #14 (Stripe checkout) so both features share one
# Supabase project without duplicate config.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
