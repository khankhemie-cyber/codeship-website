# Copy to .env.local for `next dev`. In Cloudflare Pages, set these as
# Environment Variables/Secrets instead (Test and Live are separate values —
# see the "Stripe checkout & refund policy" section of README.md).

# Server-only — never exposed to the client bundle.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Reserved for a future client-side Stripe.js/Elements embed — the current
# checkout flow redirects to a server-created Checkout Session URL and does
# not load stripe-js, so this is unused today.
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Single source of truth for the current billing term, stamped onto every
# checkout session/order. Change this one value each term.
CURRENT_TERM=2026-Sept

# Server-only — service role key, used by the Stripe webhook to persist
# orders and refund-policy acceptance (see supabase/schema.sql).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
